@page "/presenca/{activityId}"
@rendermode InteractiveServer

@inject IJSRuntime JS

<PageTitle>Registro de Presença</PageTitle>

<section class="attendance-page">
    <div class="attendance-wrapper">

        @if (_loading)
        {
            <div class="state-card">
                <div class="loading-spinner"></div>

                <h1>Carregando atividade</h1>
                <p>Aguarde enquanto buscamos as informações.</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_loadError))
        {
            <div class="state-card">
                <div class="state-symbol state-symbol--error">!</div>

                <h1>Não foi possível continuar</h1>
                <p>@_loadError</p>
            </div>
        }
        else if (_activity is not null)
        {
            <div class="attendance-brand">UNASP</div>
            <div class="attendance-card">

                <div class="attendance-card__header">

                    <span class="attendance-eyebrow">Registro de presença</span>

                    <h1>@_activity.Name</h1>

                    <p class="attendance-date">
                        @_activity.Date.ToString("dd/MM/yyyy")
                    </p>
                </div>

                <div class="attendance-windows">
                    <div class="attendance-window">
                        <span class="attendance-window__label">Entrada</span>

                        <strong>
                            @_activity.EntryStartAt.ToString("HH:mm")
                            às
                            @_activity.EntryEndAt.ToString("HH:mm")
                        </strong>
                    </div>

                    <div class="attendance-window">
                        <span class="attendance-window__label">Saída</span>

                        <strong>
                            @_activity.ExitStartAt.ToString("HH:mm")
                            às
                            @_activity.ExitEndAt.ToString("HH:mm")
                        </strong>
                    </div>
                </div>

                @if (_registrationFinished)
                {
                    <div class="registration-result">
                        <div class="state-symbol state-symbol--success">✓</div>

                        <h2>Presença registrada</h2>

                        <p>@_message</p>
                    </div>
                }
                else
                {
                    <EditForm Model="_form" OnValidSubmit="RegisterAsync" class="attendance-form">
                        <DataAnnotationsValidator />

                        <div class="form-field">
                            <label for="name">Nome completo</label>

                            <div class="form-input-wrapper">
                                <InputText id="name"
                                           class="form-input"
                                           autocomplete="name"
                                           placeholder="Digite seu nome completo"
                                           @bind-Value="_form.Name" />
                            </div>

                            <ValidationMessage For="@(() => _form.Name)" />
                        </div>

                        <div class="form-field">
                            <label for="ra">RA</label>

                            <div class="form-input-wrapper">
                                <InputText id="ra"
                                           class="form-input"
                                           inputmode="numeric"
                                           autocomplete="off"
                                           placeholder="Digite seu RA"
                                           @bind-Value="_form.RA" />
                            </div>

                            <ValidationMessage For="@(() => _form.RA)" />
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_message))
                        {
                            <div class="@GetMessageCssClass()">
                                @_message
                            </div>
                        }

                        <button type="submit"
                                class="attendance-submit"
                                disabled="@(_submitting || string.IsNullOrWhiteSpace(_deviceId))">

                            @if (_submitting)
                            {
                                <span class="button-spinner"></span>
                                <span>Registrando...</span>
                            }
                            else if (_retryRequired)
                            {
                                <span>Tentar novamente</span>
                            }
                            else
                            {
                                <span>Registrar presença</span>
                            }
                        </button>

                        <p class="attendance-help">
                            O sistema identificará automaticamente se o registro corresponde à entrada ou à saída.
                        </p>
                    </EditForm>
                }
            </div>
        }

    </div>
</section>