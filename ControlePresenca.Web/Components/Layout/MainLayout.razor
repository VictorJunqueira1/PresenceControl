@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        <div class="app-header__content">
            <a href="/" class="app-brand">
                <span class="app-brand__name">UNASP</span>
                <span class="app-brand__separator"></span>
                <span class="app-brand__description">Controle de Presença</span>
            </a>
        </div>
    </header>

    <main class="app-main">
        @Body
    </main>

    <footer class="app-footer">
        <span>Centro Universitário Adventista de São Paulo</span>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro inesperado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">×</span>
</div>