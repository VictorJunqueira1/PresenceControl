@page "/qrcode/{ActivityId}"
@rendermode InteractiveServer

@using ControlePresenca.Application.Contracts
@using ControlePresenca.Domain.Entities
@using ControlePresenca.Web.Services

@inject IActivityRepository ActivityRepository
@inject IQrCodeService QrCodeService
@inject IJSRuntime JS

<PageTitle>QR Code - Presença</PageTitle>

<section class="qr-page">
    <div class="qr-wrapper">

        @if (_loading)
        {
            <div class="qr-state">
                <div class="loading-spinner"></div>
                <p>Carregando QR Code...</p>
            </div>
        }
        else if (_activity is null)
        {
            <div class="qr-state">
                <h1>Atividade não encontrada</h1>
                <p>Não foi possível localizar a atividade informada.</p>
            </div>
        }
        else
        {
            <div class="qr-actions">
                <button type="button" class="print-button" @onclick="PrintAsync">
                    Imprimir QR Code
                </button>
            </div>

            <article class="qr-sheet">

                <header class="qr-header">
                    <span class="qr-brand">UNASP</span>

                    <span class="qr-label">
                        Controle de Presença
                    </span>
                </header>

                <div class="qr-content">
                    <span class="qr-eyebrow">Atividade</span>

                    <h1>@_activity.Name</h1>

                    <p class="qr-date">
                        @_activity.Date.ToString("dd/MM/yyyy")
                    </p>

                    <div class="qr-image-wrapper">
                        <img src="@_qrCode"
                             class="qr-image"
                             alt="QR Code para registro de presença" />
                    </div>

                    <h2>Escaneie para registrar sua presença</h2>

                    <p class="qr-description">
                        Utilize a câmera do seu celular para acessar o formulário.
                    </p>

                    <div class="qr-schedules">
                        <div>
                            <span>Entrada</span>

                            <strong>
                                @_activity.EntryWindow.StartAt.ToString("HH:mm")
                                às
                                @_activity.EntryWindow.EndAt.ToString("HH:mm")
                            </strong>
                        </div>

                        <div>
                            <span>Saída</span>

                            <strong>
                                @_activity.ExitWindow.StartAt.ToString("HH:mm")
                                às
                                @_activity.ExitWindow.EndAt.ToString("HH:mm")
                            </strong>
                        </div>
                    </div>
                </div>

                <footer class="qr-footer">
                    @_attendanceUrl
                </footer>

            </article>
        }

    </div>
</section>

@code {
    [Parameter] public string ActivityId { get; set; } = string.Empty;

    private Activity? _activity;
    private string _qrCode = string.Empty;
    private string _attendanceUrl = string.Empty;
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;

        try
        {
            _activity = await ActivityRepository.GetByIdAsync(ActivityId);

            if (_activity is not null)
            {
                _attendanceUrl = QrCodeService.BuildAttendanceUrl(_activity.Id);
                _qrCode = QrCodeService.GenerateAttendanceQrCode(_activity.Id);
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("window.print");
}